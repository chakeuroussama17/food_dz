{
  "version": "0.2.0",
  "configurations": [
    {
      // Fastest way to try the app in a browser: no debugger to attach
      // (debug mode on Chrome can time out on Windows).
      "name": "Food App (Chrome, release)",
      "type": "dart",
      "request": "launch",
      "cwd": "app",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=env.json"]
    },
    {
      "name": "Food App (Chrome, debug)",
      "type": "dart",
      "request": "launch",
      "cwd": "app",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": ["--dart-define-from-file=env.json"]
    },
    {
      "name": "Food App (connected phone)",
      "type": "dart",
      "request": "launch",
      "cwd": "app",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file=env.json"]
    }
  ]
}
